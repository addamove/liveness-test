    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "0.4.1633559619",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@tensorflow-models/face-landmarks-detection": "1.0.6"
  },
  "devDependencies": {
    "vite": "6.4.5",
    "qrcode": "1.5.4"
  },
  "engines": { "node": ">=20.19" }
}
