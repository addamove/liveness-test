{
  "name": "videx-capture-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-models.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:http": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "node scripts/copy-models.mjs && vite build",
